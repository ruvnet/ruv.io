{
  "name": "@ruv.io/code-mesh-tui",
  "version": "1.0.0",
  "description": "Terminal UI for Code Mesh - High-performance interactive interface for mesh visualization and real-time updates with napi-rs bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "code_mesh_tui",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "dependencies": {
    "@ruv.io/code-mesh-core": "workspace:*"
  },
  "keywords": [
    "tui",
    "terminal",
    "mesh",
    "visualization",
    "ui",
    "interactive",
    "napi",
    "rust",
    "real-time"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  }
}
