{
  "name": "@ruv.io/ruv-swarm-agents",
  "version": "1.0.0",
  "description": "Agent management system for RUV Swarm with lifecycle, task assignment, communication, and status monitoring - napi-rs bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "ruv_swarm_agents",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "ruv-swarm-agents",
    "agent-management",
    "swarm",
    "orchestration",
    "agent",
    "distributed",
    "lifecycle",
    "task-assignment",
    "communication",
    "status-monitoring",
    "napi",
    "rust"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@ruv.io/ruv-swarm-core": "*"
  },
  "engines": {
    "node": ">= 14"
  }
}
