{
  "name": "@ruv.io/strange-loop",
  "version": "0.3.0",
  "description": "Hyper-optimized strange loops with temporal consciousness and quantum-classical hybrid computing",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "strange_loop",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "strange-loop",
    "temporal",
    "quantum",
    "computing",
    "napi",
    "rust",
    "native",
    "high-performance"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  }
}
