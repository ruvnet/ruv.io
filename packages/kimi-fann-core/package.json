{
  "name": "@ruv.io/kimi-fann-core",
  "version": "0.1.4",
  "description": "Optimized micro-expert neural architecture for Kimi-K2 WASM conversion with 5-10x performance improvements",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "kimi_fann_core",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "kimi",
    "fann",
    "neural-networks",
    "ai",
    "machine-learning",
    "napi",
    "rust",
    "high-performance"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/ruv.io.git",
    "directory": "packages/kimi-fann-core"
  }
}
