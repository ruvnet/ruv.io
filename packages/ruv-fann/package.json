{
  "name": "@ruv.io/ruv-fann",
  "version": "0.1.6",
  "description": "A pure Rust implementation of the Fast Artificial Neural Network (FANN) library",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "ruv_fann",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "neural-network",
    "fann",
    "machine-learning",
    "ai",
    "napi",
    "rust",
    "high-performance"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  }
}
