{
  "name": "@ruv.io/micro_routing",
  "version": "1.0.0",
  "description": "High-performance request routing for microservices with napi-rs bindings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "*.node",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "build": "napi build --platform --release && tsc",
    "build:debug": "napi build --platform && tsc",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release && tsc",
    "test": "vitest",
    "universal": "napi universal",
    "clean": "rimraf dist"
  },
  "napi": {
    "name": "micro_routing",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "routing",
    "microservices",
    "load-balancing",
    "service-discovery",
    "health-check",
    "napi",
    "rust"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  }
}
