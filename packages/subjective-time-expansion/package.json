{
  "name": "@ruv.io/subjective-time-expansion",
  "version": "0.1.0",
  "description": "High-performance time dilation engine for AI consciousness - NAPI bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "clean": "rimraf dist *.node *.d.ts *.js index.d.ts index.js",
    "lint": "eslint src --ext .ts,.rs",
    "format": "prettier --write 'src/**/*.ts' && cargo fmt"
  },
  "napi": {
    "name": "subjective_time_expansion",
    "triples": {
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "subjective-time-expansion",
    "time-dilation",
    "ai",
    "consciousness",
    "rust",
    "napi",
    "performance",
    "native"
  ],
  "author": "rUv <support@ruv.io>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/ruv.io.git",
    "directory": "packages/subjective-time-expansion"
  },
  "homepage": "https://github.com/ruvnet/ruv.io/tree/main/packages/subjective-time-expansion"
}
