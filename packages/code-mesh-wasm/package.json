{
  "name": "@ruv.io/code-mesh-wasm",
  "version": "0.1.0",
  "description": "WebAssembly bindings for Code Mesh - High-performance WASM interface with browser compatibility",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "code_mesh_wasm",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "code-mesh",
    "wasm",
    "webassembly",
    "browser",
    "performance",
    "distributed",
    "swarm",
    "napi",
    "rust"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  }
}
