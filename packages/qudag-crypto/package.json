{
  "name": "@ruv.io/qudag-crypto",
  "version": "0.5.1",
  "description": "Quantum-resistant cryptography library for QuDAG - includes ML-KEM-768, ML-DSA, HQC, and BLAKE3",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublishOnly --skip-gh-release",
    "test": "vitest",
    "universal": "napi universal"
  },
  "napi": {
    "name": "qudag_crypto",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": [
    "qudag",
    "crypto",
    "quantum-resistant",
    "post-quantum",
    "ml-kem",
    "ml-dsa",
    "hqc",
    "blake3",
    "napi",
    "rust"
  ],
  "author": "ruv.io team",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">= 14"
  }
}
